{
  "name": "tidyspace",
  "productName": "TidySpace",
  "version": "0.1.0",
  "description": "Descubra o que está ocupando espaço em disco — por disco inteiro ou por pasta.",
  "author": "Working Minds <tidyspace@wkm.com.br>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@napi-rs/cli": "^3.10.9",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "dev": "node scripts/electron-env.mjs electron-vite dev",
    "dev:node": "node scripts/electron-env.mjs electron-vite dev -- --engine=node",
    "dev:native": "node scripts/electron-env.mjs electron-vite dev -- --engine=native",
    "build": "electron-vite build",
    "preview": "node scripts/electron-env.mjs electron-vite preview",
    "build:native": "napi build --cwd src/native/node --platform --release --output-dir dist --no-js --dts index.d.ts",
    "build:native:debug": "napi build --cwd src/native/node --platform --output-dir dist --no-js --dts index.d.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs",
    "icons": "node scripts/electron-env.mjs electron scripts/make-icons.mjs",
    "test:native": "cargo test --manifest-path src/native/Cargo.toml",
    "lint:native": "cargo fmt --manifest-path src/native/Cargo.toml --all --check && cargo clippy --manifest-path src/native/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run lint && npm run typecheck && npm run test",
    "package": "npm run build && electron-builder --publish never"
  }
}
